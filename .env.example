# Copy to .env and fill in keys. .env is git-ignored and excluded from the
# Docker build context via .dockerignore — secrets are injected at runtime only.

ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
PINECONE_API_KEY=""
PINECONE_INDEX_NAME_V2="civ6-bbg-v2"

# Password gate for the Streamlit UI
APP_PASSWORD=""

# Shared secret required on POST /query and POST /warm as the X-API-Key header.
# Read by BOTH surfaces now: src/api.py fails to import without it, so the API
# refuses to start rather than coming up with an open endpoint, and the
# Streamlit client sends it on every call.
# Generate with: openssl rand -hex 32
API_SHARED_SECRET=""

# Where the Streamlit frontend finds the API. Defaults to http://localhost:8000
# when unset, which is correct for a bare local run. Compose sets it to
# http://api:8000 for the app service; Streamlit Cloud sets it to the API
# Gateway URL as a Cloud secret (Cloud has no environment variables, only
# st.secrets, which is why src/secrets.py checks st.secrets first).
# API_BASE_URL="http://localhost:8000"

# REQUIRED wherever the pipeline runs (the api service, the eval runner's
# memory probes, a bare uvicorn). There is no in-memory fallback any more:
# build_checkpointer() raises and the service refuses to start if this is unset
# or unreachable, because a memory-only deployment is one that has stopped
# persisting anything while still looking healthy. Inside Compose it is set in
# docker-compose.yml's environment block for the api service instead.
# The Streamlit frontend does NOT need this and has no psycopg in its image.
# DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"
